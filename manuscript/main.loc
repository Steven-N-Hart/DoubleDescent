\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{Architecture depth}}{9}{section*.20}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{Throughout, $P$ denotes the total number of trainable parameters in the network.}}{10}{section*.21}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{The interpolation threshold at $P \approx 625$ parameters is consistent with theoretical predictions \citep {liu2025understanding, belkin2019reconciling} and lies between $N = 600$ training samples and $N_{\text {events}} \approx 420$ observed events. Three lines of evidence support its validity rather than it being an artifact of overparameterization on a simple problem: (1) the threshold location aligns with the regime where a unique interpolating solution exists, (2) under high censoring (Scenario\nobreakspace {}D, $N_{\text {events}} \approx 100$), the pattern is attenuated as predicted by the reduced effective sample size, and (3) Scenario\nobreakspace {}E with nonlinear ground truth exhibits a threshold at the same location, confirming it depends on the data dimensions rather than problem complexity.}}{12}{section*.22}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{F (Mixed)}}{13}{section*.23}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{10 cont.\ + 3 cat.}}{13}{section*.24}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{$0.738 \pm 0.082$}}{13}{section*.25}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{$0.659 \pm 0.055$}}{13}{section*.26}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{$0.711 \pm 0.063$}}{13}{section*.27}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{G (High-dim.)}}{13}{section*.28}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{50 features, 25 predictive}}{13}{section*.29}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{$0.838 \pm 0.083$}}{13}{section*.30}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{$0.779 \pm 0.026^{\dagger }$}}{13}{section*.31}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{$0.861 \pm 0.017$}}{13}{section*.32}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{H (Depth-4)}}{13}{section*.33}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{Depth-4 width sweep}}{13}{section*.34}%
\contentsline {added}{Added\nobreakspace {}(R1): \truncate {\Changestruncatewidth }{$0.695 \pm 0.158$}}{13}{section*.35}%

{
  "$schema": "../schemas/experiment.json",
  "experiment_id": "depth_001",
  "name": "Depth Variation Double Descent",
  "description": "Fixed width=64, sweep depth 1-5; also full width sweep at depth=4 (Revision R1.3)",
  "seed": 42,
  "data": {
    "name": "baseline",
    "description": "Standard Gaussian covariates with 30% censoring",
    "n_samples": 1000,
    "n_features": 20,
    "n_predictive": 10,
    "covariate_type": "gaussian",
    "censoring_rate": 0.3
  },
  "model": {
    "widths": [64],
    "depths": [1, 2, 3, 4, 5],
    "activation": "relu",
    "dropout": 0.0,
    "weight_decay": 0.0
  },
  "training": {
    "epochs": 10000,
    "batch_size": 256,
    "learning_rate": 0.001,
    "optimizer": "adam"
  },
  "splits": {
    "train": 0.6,
    "val": 0.2,
    "test": 0.2
  }
}
